# Deployment configuration (copy to .env and fill in)
PRIVATE_KEY=0x...

# Existing USDT; leave empty to deploy a MockUSDT (local only)
USDT_ADDRESS=
USDT_DECIMALS=18

TREASURY=
LIQUIDITY=
TEAM_BENEFICIARY=
ECOSYSTEM=
# Final multisig. Ownership is transferred with Ownable2Step.
OWNER=

BNB_PRICE_USD=600000000000000000000
MINING_START_DELAY=3600
SALE_ACTIVE=true

# Local dev only. NEVER enable on mainnet.
ALLOW_SELF_REGISTRATION=false
