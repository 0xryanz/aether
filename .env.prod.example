# ---------------------------------------------------------------------------
# Production environment for `docker compose --env-file .env.prod up -d --build`
# ---------------------------------------------------------------------------

# Public hostname pointed at this server (A record). No protocol, no trailing dot.
DOMAIN=forge.example.com
ACME_EMAIL=ops@example.com
# 1 = Let's Encrypt staging (use this first), 0 = production certificates.
ACME_STAGING=0
# 1 = re-issue even if a certificate marker already exists.
ACME_FORCE=0

# ---------------------------------------------------------------------------
# Frontend build args (NEXT_PUBLIC_* are baked into the bundle at build time).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_AETHER_ADDRESS=
NEXT_PUBLIC_RELIC_ADDRESS=
NEXT_PUBLIC_LOOM_ADDRESS=
NEXT_PUBLIC_FORGE_ADDRESS=
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=0x55d398326f99059fF775485246999027B3197955
NEXT_PUBLIC_USDT_DECIMALS=18
NEXT_PUBLIC_DEPLOY_BLOCK=0
NEXT_PUBLIC_RPC_URL=https://bsc-dataseed.bnbchain.org
# Must stay 0 on mainnet.
NEXT_PUBLIC_DEMO_FAUCET=0
NEXT_PUBLIC_SELF_REGISTER=0
