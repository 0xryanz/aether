# ---------------------------------------------------------------------------
# Aether Forge web configuration
# Copy to .env.local and fill in the addresses produced by the deploy script.
# ---------------------------------------------------------------------------

# 56 = BNB Chain, 97 = BNB testnet, 31337 = local anvil
NEXT_PUBLIC_CHAIN_ID=31337

NEXT_PUBLIC_AETHER_ADDRESS=
NEXT_PUBLIC_RELIC_ADDRESS=
NEXT_PUBLIC_LOOM_ADDRESS=
NEXT_PUBLIC_FORGE_ADDRESS=
NEXT_PUBLIC_MARKET_ADDRESS=
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_USDT_ADDRESS=
NEXT_PUBLIC_USDT_DECIMALS=18

# Block the deploy landed in; used as the floor for event indexing.
NEXT_PUBLIC_DEPLOY_BLOCK=0

# Local demo helpers (never enable on mainnet): public USDT faucet + self
# service Agent ID registration.
NEXT_PUBLIC_DEMO_FAUCET=1
NEXT_PUBLIC_SELF_REGISTER=1

# Optional read-only RPC override (defaults to the wallet's transport).
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Optional WalletConnect project id. Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
